CC = gcc
CFLAGS = -Wall -Wextra -std=c11 -g
TARGET = dots_and_boxes
SRCS = src/main.c src/board.c src/game.c src/display.c src/input.c
OBJS = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $(TARGET) $(OBJS)

src/%.o: src/%.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)
